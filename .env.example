# ---- LLM ----------------------------------------------------------------
# Modelo usado pelo interpretador (formato do model router do Mastra: provedor/modelo).
# Sem chave configurada, o Nexo Assist usa o interpretador offline (regras + palavras-chave).
NEXO_MODEL=anthropic/claude-haiku-5-5
ANTHROPIC_API_KEY=
# Para trocar de provedor, por exemplo: NEXO_MODEL=openai/gpt-5-mini e OPENAI_API_KEY=...
# Força o modo offline mesmo com chave (útil para testes e demonstração sem custo).
NEXO_OFFLINE=false

# ---- Servidores ---------------------------------------------------------
APP_PORT=4000
TICKETS_PORT=4100
TICKETS_SERVICE_URL=http://localhost:4100
# Segredo compartilhado entre a API e o serviço de chamados.
TICKETS_SERVICE_TOKEN=troque-este-segredo
# Probabilidade (0 a 1) de o serviço de chamados "legado" responder 503 — simula instabilidade.
TICKETS_FAILURE_RATE=0.1

# ---- Limites ------------------------------------------------------------
MAX_USER_MESSAGES_PER_CONVERSATION=30
CHAT_RATE_LIMIT_PER_MINUTE=12
