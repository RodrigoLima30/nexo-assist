{
  "name": "nexo-assist",
  "version": "1.0.0",
  "private": true,
  "description": "Nexo Assist — agent de atendimento do service desk de TI (desafio técnico).",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "concurrently -k -n tickets,api,web -c yellow,cyan,magenta \"npm:dev:tickets\" \"npm:dev:api\" \"npm:dev:web\"",
    "dev:tickets": "node --watch-path=server --watch-path=shared --import tsx server/tickets-service/main.ts",
    "dev:api": "node --watch-path=server --watch-path=shared --import tsx server/app/main.ts",
    "dev:web": "vite",
    "build": "vite build",
    "start": "concurrently -k -n tickets,api -c yellow,cyan \"tsx server/tickets-service/main.ts\" \"tsx server/app/main.ts\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "eval": "tsx scripts/eval.ts",
    "reset": "tsx scripts/reset.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "@mastra/core": "^1.79.0",
    "dotenv": "^18.0.9",
    "hono": "^4.13.14",
    "lucide-react": "^1.62.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
